# ─── Core ──────────────────────────────────────────────────────────────
ENV=development              # development | production | testing
HOST=0.0.0.0
PORT=8000

# ─── Security ──────────────────────────────────────────────────────────
ADMIN_KEY=                   # Legacy API-only admin access. Set for automation/scripts.
ADMIN_EMAILS=                # Comma-separated user emails with admin access.
                             # Example: admin@swiftgate.dev,you@example.com
                             # These users see the admin panel when logged in.
CORS_ORIGINS=*               # Comma-separated allowlist. Use * only for development.
                             # Production: https://your-app.com,https://admin.your-app.com

# ─── User Auth (JWT for user portal) ────────────────────────────────────
JWT_SECRET=                  # Required in production. Set to a strong random string.
                             # Generate: openssl rand -hex 32
JWT_EXPIRY_HOURS=168         # Token validity (default: 7 days)

# ─── Database ──────────────────────────────────────────────────────────
# Railway: auto-set by PostgreSQL plugin. Local: use SQLite.
DATABASE_URL=sqlite+aiosqlite:///./data/swiftgate.db
# Postgres: postgresql+asyncpg://user:pass@localhost:5432/swiftgate

# ─── Redis (optional — for distributed rate limiting) ───────────────────
# Railway: auto-set by Redis plugin. Local: leave empty for in-memory fallback.
REDIS_URL=
# Redis: redis://localhost:6379

# ─── Provider API Keys (BYOK from gateway operator) ────────────────────
# These are the keys SwiftGate uses to call upstream providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPINFRA_API_KEY=
TOGETHER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
NOVITA_API_KEY=
FIREWORKS_API_KEY=
GROQ_API_KEY=
MINIMAX_API_KEY=
TENCENT_API_KEY=
BYTEDANCE_API_KEY=

# ─── Gateway Margin ────────────────────────────────────────────────────
TOKEN_MARGIN=0.01            # 1% markup on token costs

# ─── Stripe (credit purchases) ─────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=           # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=       # whsec_... (from Stripe webhook settings)

# ─── Routing ───────────────────────────────────────────────────────────
DEFAULT_ROUTING=balanced     # cheapest | fastest | balanced | quality

# ─── Semantic Cache ────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_SEMANTIC_MATCH=true    # Jaccard similarity matching
CACHE_SHARED_DEFAULT=false   # Cross-user caching (privacy-sensitive)
CACHE_TTL_HOURS=24

# ─── PII Redaction ─────────────────────────────────────────────────────
PII_REDACTION_ENABLED=false  # Strip PII before sending to providers
PII_REHYDRATE_RESPONSE=true  # Restore original PII in responses

# ─── Ports for docker-compose ──────────────────────────────────────────
BACKEND_PORT=8000
WEB_PORT=3001
LANDING_PORT=3002
